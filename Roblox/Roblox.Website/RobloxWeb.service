# to view logs:
# sudo journalctl -u RobloxWeb.service -f
#
# example paths below assume you cloned the source to /opt/pekora - change them
# to wherever your copy actually lives, and change User= to your own user
[Unit]
Description=Roblox website service
After=network.service

[Service]
ExecStart=/opt/pekora/Roblox/Roblox.Website/bin/publish/Roblox.Website
LimitNOFILE=900000
LimitNPROC=900000
# Required on some systems
WorkingDirectory=/opt/pekora/Roblox/Roblox.Website/bin/publish/
Restart=always
# Restart service after 1 second if service crashes
RestartSec=1
# Uncomment to ignore 0 exit code
# RemainAfterExit=yes
SyslogIdentifier=RobloxWeb
User=website

[Install]
WantedBy=multi-user.target
