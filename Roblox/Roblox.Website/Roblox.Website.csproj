<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>8618</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fleck" Version="1.2.0" />
    <PackageReference Include="JWT" Version="8.7.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="7.2.0" />
    <PackageReference Include="TwoFactorAuth.Net" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Public" />
  </ItemGroup>

  <ItemGroup>
    <!-- the fix jitter bundles, used by the asset conversion endpoint. they sit in
         Roblox/FixJitter in the repo, so drop a copy next to the build output -->
    <None Include="..\FixJitter\*.rbxm" CopyToOutputDirectory="PreserveNewest" Link="FixJitter\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- the app reads both of these from its working directory, which breaks as soon
         as you run the published build instead of "dotnet run" -->
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.json')" />
    <None Include="game-servers.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('game-servers.json')" />
    <None Update="Keys/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Roblox.AbuseDetection\Roblox.AbuseDetection.csproj" />
    <ProjectReference Include="..\Roblox.Configuration\Roblox.Configuration.csproj" />
    <ProjectReference Include="..\Roblox.Dto\Roblox.Dto.csproj" />
    <ProjectReference Include="..\Roblox.EconomyChat\Roblox.EconomyChat.csproj" />
    <ProjectReference Include="..\Roblox.Libraries\Roblox.Libraries.csproj" />
    <ProjectReference Include="..\Roblox.Models\Roblox.Models.csproj" />
    <ProjectReference Include="..\Roblox.Services\Roblox.Services.csproj" />
    <ProjectReference Include="..\Roblox.Exceptions\Roblox.Exceptions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="Pages\Admi\Home.cshtml" />
  </ItemGroup>

</Project>
